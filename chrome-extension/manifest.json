{
  "manifest_version": 3,
  "name": "Lanvi",
  "short_name": "Lanvi",
  "version": "0.6.0",
  "description": "Discover Lanvi devices, receive encrypted files, and stream phone music and videos over your local network.",
  "minimum_chrome_version": "120",
  "permissions": [
    "downloads",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:8788/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open Lanvi Receiver",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/lanvi-16.png",
      "32": "icons/lanvi-32.png",
      "48": "icons/lanvi-48.png"
    }
  },
  "icons": {
    "16": "icons/lanvi-16.png",
    "32": "icons/lanvi-32.png",
    "48": "icons/lanvi-48.png",
    "128": "icons/lanvi-128.png"
  }
}
